# Copy with: cp -n .env.example .env
# Bark device key or a URL ending in that key.
BAARK_DEVICE_KEY="YOUR_DEVICE_KEY"

# Optional custom server. Leave commented when using a full device URL above.
# BAARK_SERVER_URL="https://notify.example.com/bark"

# Optional encryption; match the Bark app. Leave unused options commented out.
# BAARK_ENCRYPTION_KEY="YOUR_EXISTING_BARK_ENCRYPTION_KEY"
# Modes: GCM (noPadding), CBC (pkcs7), or ECB (pkcs7).
# BAARK_ENCRYPTION_MODE="GCM"

# Optional fixed CBC IV. Otherwise GCM/CBC generate fresh IVs; ECB has none.
# BAARK_ENCRYPTION_IV="YOUR_EXISTING_CBC_IV"

# Optional E2E media; direct image URLs reachable by the iPhone.
# BAARK_E2E_LOGO_URL="https://example.com/your-logo.png"
# BAARK_E2E_IMAGE_URL="https://example.com/your-image.jpg"
